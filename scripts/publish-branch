#!/bin/sh

set -eu

if [ "$#" -gt 1 ]; then
	echo "usage: $0 [output]" >&2
	exit 2
fi

output=$(realpath -- "${1:-public}")
worktree=$(mktemp -d)
trap 'git worktree remove --force "$worktree" >/dev/null 2>&1 || true' EXIT HUP INT TERM

if git show-ref --verify --quiet refs/remotes/origin/published; then
	git worktree add -B published "$worktree" origin/published
else
	git worktree add --detach "$worktree"
	(
		cd "$worktree"
		git switch --orphan published
		git rm -rf .
	)
fi

find "$worktree" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
cp -a "$output/." "$worktree/"

(
	cd "$worktree"
	git add --all
	if git diff --cached --quiet; then
		exit 0
	fi
	git commit -m 'Publish package repository metadata'
	git push origin HEAD:published
)
