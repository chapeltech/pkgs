#!/bin/sh

set -eu

if [ "$#" -gt 3 ]; then
	echo "usage: $0 [artifacts] [output] [alpine-release]" >&2
	exit 2
fi

artifacts=${1:-artifacts}
output=${2:-public}
alpine_release=${3:-alpine-release}
top=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
manifest=$top/packages.json
organization=$(jq -er .organization "$manifest")
fingerprint=${ARCHIVE_SIGNING_SUBKEY_FINGERPRINT:?ARCHIVE_SIGNING_SUBKEY_FINGERPRINT is required}
passphrase=${ARCHIVE_SIGNING_PASSPHRASE:?ARCHIVE_SIGNING_PASSPHRASE is required}
alpine_key=${ALPINE_SIGNING_KEY:?ALPINE_SIGNING_KEY is required}

"$top/scripts/check-signing-key"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
printf '%s' "$passphrase" >"$work/passphrase"
chmod 600 "$work/passphrase"
mkdir -p "$work/seen"
printf '%s' "$alpine_key" >"$work/chapeltech-alpine.rsa"
chmod 600 "$work/chapeltech-alpine.rsa"

rm -rf "$output" "$alpine_release"
mkdir -p "$output/keys" \
	"$output/debian/dists/trixie/main/binary-amd64" \
	"$output/debian/dists/trixie/main/binary-arm64" \
	"$output/alpine/v3.24/main/x86_64" \
	"$output/alpine/v3.24/main/aarch64" \
	"$output/rpm/el9/x86_64/Packages" "$alpine_release"

gpg --batch --export "$fingerprint" \
	>"$output/keys/chapeltech-archive-keyring.gpg"
gpg --batch --armor --export "$fingerprint" \
	>"$output/keys/chapeltech-archive-keyring.asc"
openssl rsa -in "$work/chapeltech-alpine.rsa" -pubout \
	-out "$output/keys/chapeltech-alpine.rsa.pub"

rpmdb=$work/rpmdb
rpm --define "_dbpath $rpmdb" --initdb
rpmkeys --define "_dbpath $rpmdb" --import \
	"$output/keys/chapeltech-archive-keyring.asc"

while IFS='	' read -r repository tag name url extra; do
	if [ -z "$repository" ] || [ -z "$tag" ] || [ -z "$name" ] || \
	    [ -z "$url" ] || [ -n "$extra" ]; then
		echo "invalid release manifest entry" >&2
		exit 1
	fi
	case "$repository" in
	''|.|..|*/*)
		echo "unsafe repository in release manifest: $repository" >&2
		exit 1
		;;
	esac
	case "$tag" in
	''|.|..|*/*)
		echo "unsafe tag in release manifest: $tag" >&2
		exit 1
		;;
	esac
	case "$name" in
	''|.|..|*/*)
		echo "unsafe release manifest entry: $repository $tag $name" >&2
		exit 1
		;;
	esac
	if ! jq -e --arg repository "$repository" \
	    '.repositories | index($repository) != null' "$manifest" >/dev/null; then
		echo "release manifest contains unconfigured repository: $repository" >&2
		exit 1
	fi
	encoded_tag=$(jq -nr --arg value "$tag" '$value | @uri')
	encoded_name=$(jq -nr --arg value "$name" '$value | @uri')
	expected=https://github.com/$organization/$repository/releases/download/$encoded_tag/$encoded_name
	if [ "$url" != "$expected" ]; then
		echo "release manifest contains unexpected asset URL: $url" >&2
		exit 1
	fi
	source=$artifacts/$repository/$tag/$name
	test -f "$source"
	case "$name" in
	*.deb)
		arch=$(dpkg-deb -f "$source" Architecture)
		case "$arch" in
		amd64|arm64)
			touch "$work/seen/$repository-deb-$arch"
			;;
		all)
			touch "$work/seen/$repository-deb-amd64"
			touch "$work/seen/$repository-deb-arm64"
			;;
		*)
			echo "ignoring unsupported Debian architecture: $name ($arch)" >&2
			continue
			;;
		esac
		destination=$output/debian/pool/github/$organization/$repository/releases/download/$tag/$name
		;;
	*.rpm)
		arch=$(rpm --define "_dbpath $rpmdb" -qp --qf '%{ARCH}' "$source")
		case "$arch" in
		x86_64|noarch)
			;;
		*)
			echo "ignoring unsupported RPM architecture: $name ($arch)" >&2
			continue
			;;
		esac
		signature=$(rpm --define "_dbpath $rpmdb" -qp \
		    --qf '%{RSAHEADER:pgpsig}%{DSAHEADER:pgpsig}%{SIGPGP:pgpsig}%{SIGGPG:pgpsig}' \
		    "$source")
		if [ "$signature" = '(none)(none)(none)(none)' ]; then
			echo "ignoring unsigned legacy RPM: $name" >&2
			continue
		fi
		rpmkeys --define "_dbpath $rpmdb" --checksig "$source" |
		    grep -q 'digests signatures OK$'
		touch "$work/seen/$repository-rpm-$arch"
		destination=$output/rpm/el9/x86_64/Packages/github/$organization/$repository/releases/download/$tag/$name
		;;
	*.apk)
		case "$name" in
		*.x86_64.apk)
			alpine_arches=x86_64
			repository_name=${name%.x86_64.apk}.apk
			;;
		*.aarch64.apk)
			alpine_arches=aarch64
			repository_name=${name%.aarch64.apk}.apk
			;;
		*)
			echo "ignoring unsupported Alpine architecture: $name" >&2
			continue
			;;
		esac
		apk --keys-dir "$(realpath -- "$output/keys")" verify "$source"
		for arch in $alpine_arches; do
			touch "$work/seen/$repository-apk-$arch"
			destination=$output/alpine/v3.24/main/$arch/$repository_name
			if [ -e "$destination" ] || [ -L "$destination" ]; then
				echo "duplicate Alpine package filename: $repository_name" >&2
				exit 1
			fi
			ln -s "$(realpath -- "$source")" "$destination"
		done
		continue
		;;
	*)
		continue
		;;
	esac
	mkdir -p "$(dirname -- "$destination")"
	ln -s "$(realpath -- "$source")" "$destination"
done <"$artifacts/releases.tsv"

for repository in $(jq -r '.repositories[]' "$manifest"); do
	for arch in amd64 arm64; do
		test -f "$work/seen/$repository-deb-$arch" || {
			echo "missing $arch Debian packages for $repository" >&2
			exit 1
		}
	done
	test -f "$work/seen/$repository-rpm-x86_64" || {
		echo "missing signed EL9 packages for $repository" >&2
		exit 1
	}
	if jq -e --arg repository "$repository" \
	    '.alpine_repositories | index($repository) != null' \
	    "$manifest" >/dev/null; then
		for arch in x86_64 aarch64; do
			test -f "$work/seen/$repository-apk-$arch" || {
				echo "missing $arch Alpine packages for $repository" >&2
				exit 1
			}
		done
	fi
done

(
	cd "$output/debian"
	for arch in amd64 arm64; do
		dpkg-scanpackages --arch "$arch" pool /dev/null \
		    >"dists/trixie/main/binary-$arch/Packages"
		gzip -9n -c "dists/trixie/main/binary-$arch/Packages" \
		    >"dists/trixie/main/binary-$arch/Packages.gz"
	done
	apt-ftparchive \
	    -o APT::FTPArchive::Release::Origin=ChapelTech \
	    -o APT::FTPArchive::Release::Label=ChapelTech \
	    -o APT::FTPArchive::Release::Suite=trixie \
	    -o APT::FTPArchive::Release::Codename=trixie \
	    -o 'APT::FTPArchive::Release::Architectures=amd64 arm64' \
	    -o APT::FTPArchive::Release::Components=main \
	    -o 'APT::FTPArchive::Release::Description=ChapelTech packages for Debian 13' \
	    release dists/trixie >dists/trixie/Release
	gpg --batch --yes --pinentry-mode loopback \
	    --passphrase-file "$work/passphrase" --local-user "$fingerprint!" \
	    --armor --detach-sign \
	    --output dists/trixie/Release.gpg dists/trixie/Release
	gpg --batch --yes --pinentry-mode loopback \
	    --passphrase-file "$work/passphrase" --local-user "$fingerprint!" \
	    --clearsign \
	    --output dists/trixie/InRelease dists/trixie/Release
)

createrepo_c --quiet --general-compress-type=gz "$output/rpm/el9/x86_64"
gpg --batch --yes --pinentry-mode loopback \
	--passphrase-file "$work/passphrase" --local-user "$fingerprint!" \
	--armor --detach-sign \
	--output "$output/rpm/el9/x86_64/repodata/repomd.xml.asc" \
	"$output/rpm/el9/x86_64/repodata/repomd.xml"

for arch in x86_64 aarch64; do
	directory=$output/alpine/v3.24/main/$arch
	apk --keys-dir "$(realpath -- "$output/keys")" index --no-warnings \
		--description 'ChapelTech packages for Alpine 3.24' \
		--output "$directory/APKINDEX.tar.gz" "$directory"/*.apk
	"$top/scripts/sign-alpine-index" "$work/chapeltech-alpine.rsa" \
		chapeltech-alpine.rsa.pub "$directory/APKINDEX.tar.gz"
	cp "$directory/APKINDEX.tar.gz" \
		"$alpine_release/alpine-$arch-APKINDEX.tar.gz"
	for package in "$directory"/*.apk; do
		cp -L "$package" \
			"$alpine_release/alpine-$arch-$(basename -- "$package")"
	done
done

rm -rf "$output/debian/pool" "$output/rpm/el9/x86_64/Packages"
find "$output/alpine" -type l -name '*.apk' -delete

mkdir -p "$output/config"
cat >"$output/config/chapeltech.sources" <<'EOF'
Types: deb
URIs: https://repo.chapeltech.uk/debian
Suites: trixie
Components: main
Signed-By: /etc/apt/keyrings/chapeltech-archive-keyring.gpg
EOF

cat >"$output/config/chapeltech.repo" <<'EOF'
[chapeltech]
name=ChapelTech packages for EL 9.6 and later
baseurl=https://repo.chapeltech.uk/rpm/el9/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://repo.chapeltech.uk/keys/chapeltech-archive-keyring.asc
EOF

cat >"$output/config/chapeltech-alpine.repositories" <<'EOF'
https://repo.chapeltech.uk/alpine/v3.24/main
EOF

cat >"$output/index.html" <<'EOF'
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>ChapelTech packages</title></head>
<body>
<h1>ChapelTech packages</h1>
<p>Debian 13 packages are available for amd64 and arm64.</p>
<p>EL 9.6 and later packages are available for x86_64.</p>
<p>Alpine 3.24 packages are available for x86_64 and aarch64.</p>
<ul>
<li><a href="/config/chapeltech.sources">APT source configuration</a></li>
<li><a href="/config/chapeltech.repo">DNF repository configuration</a></li>
<li><a href="/config/chapeltech-alpine.repositories">APK repository configuration</a></li>
<li><a href="/keys/chapeltech-archive-keyring.gpg">APT archive key</a></li>
<li><a href="/keys/chapeltech-archive-keyring.asc">ASCII-armored archive key</a></li>
<li><a href="/keys/chapeltech-alpine.rsa.pub">APK repository key</a></li>
</ul>
</body>
</html>
EOF
