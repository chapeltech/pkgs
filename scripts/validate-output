#!/bin/sh

set -eu

if [ "$#" -gt 2 ]; then
	echo "usage: $0 [output] [alpine-release]" >&2
	exit 2
fi

output=${1:-public}
alpine_release=${2:-alpine-release}
top=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
manifest=$top/packages.json
organization=$(jq -er .organization "$manifest")

test -s "$output/debian/dists/trixie/InRelease"
test -s "$output/debian/dists/trixie/Release"
test -s "$output/debian/dists/trixie/Release.gpg"
test -s "$output/rpm/el9/x86_64/repodata/repomd.xml"
test -s "$output/rpm/el9/x86_64/repodata/repomd.xml.asc"
test -s "$output/alpine/v3.24/main/x86_64/APKINDEX.tar.gz"
test -s "$output/alpine/v3.24/main/aarch64/APKINDEX.tar.gz"
test -s "$output/keys/chapeltech-archive-keyring.gpg"
test -s "$output/keys/chapeltech-archive-keyring.asc"
test -s "$output/keys/chapeltech-alpine.rsa.pub"

gpgv --keyring "$output/keys/chapeltech-archive-keyring.gpg" \
	"$output/debian/dists/trixie/InRelease"
gpgv --keyring "$output/keys/chapeltech-archive-keyring.gpg" \
	"$output/debian/dists/trixie/Release.gpg" \
	"$output/debian/dists/trixie/Release"
gpgv --keyring "$output/keys/chapeltech-archive-keyring.gpg" \
	"$output/rpm/el9/x86_64/repodata/repomd.xml.asc" \
	"$output/rpm/el9/x86_64/repodata/repomd.xml"

release=$output/debian/dists/trixie/Release
grep -qx 'Architectures: amd64 arm64' "$release"
grep -qx 'Codename: trixie' "$release"
grep -qx 'Components: main' "$release"
grep -qx 'Suite: trixie' "$release"

for arch in amd64 arm64; do
	packages=$output/debian/dists/trixie/main/binary-$arch/Packages
	test -s "$packages"
	test -s "$packages.gz"
	gzip -cd "$packages.gz" | cmp - "$packages"
	grep -q "^Architecture: $arch$" "$packages"
	grep -q '^Architecture: all$' "$packages"
	if grep '^Architecture:' "$packages" |
	    grep -Evx "Architecture: ($arch|all)" | grep -q .; then
		echo "unexpected architecture in $packages" >&2
		exit 1
	fi
	sed -n 's/^Filename: //p' "$packages" | while IFS= read -r filename; do
		case "$filename" in
		pool/github/$organization/*/releases/download/*/*.deb)
			;;
		*)
			echo "non-canonical Debian payload URL: $filename" >&2
			exit 1
			;;
		esac
		case "$filename" in
		*/latest/download/*)
			echo "mutable Debian payload URL: $filename" >&2
			exit 1
			;;
		esac
		relative=${filename#pool/github/"$organization"/}
		repository=${relative%%/*}
		if ! jq -e --arg repository "$repository" \
		    '.repositories | index($repository) != null' "$manifest" >/dev/null; then
			echo "unconfigured Debian payload repository: $repository" >&2
			exit 1
		fi
	done
	for repository in $(jq -r '.repositories[]' "$manifest"); do
		grep -q "^Filename: pool/github/$organization/$repository/releases/download/" \
		    "$packages"
	done
done

set -- "$output/rpm/el9/x86_64/repodata/"*-primary.xml.gz
if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
	echo "expected one gzip-compressed RPM primary metadata file" >&2
	exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM

for arch in x86_64 aarch64; do
	mkdir -p "$work/apk-root-$arch"
	apk --root "$work/apk-root-$arch" --arch "$arch" \
		--usermode --initdb --no-network add
	printf '%s\n' "$(realpath -- "$output/alpine/v3.24/main")" \
		>"$work/repositories-$arch"
	apk --root "$work/apk-root-$arch" --arch "$arch" \
		--keys-dir "$(realpath -- "$output/keys")" \
		--repositories-file "$work/repositories-$arch" \
		--no-network update

	prefix=alpine-$arch-
	index=$alpine_release/${prefix}APKINDEX.tar.gz
	test -s "$index"
	cmp "$output/alpine/v3.24/main/$arch/APKINDEX.tar.gz" "$index"
	first=$(find "$alpine_release" -maxdepth 1 -type f \
		-name "$prefix*.apk" -print -quit)
	test -n "$first"

	expected=$work/alpine-assets-$arch
	tar -xOzf "$index" APKINDEX |
	awk -F: '
	    $1 == "P" { package = $2 }
	    $1 == "V" { version = $2 }
	    NF == 0 && package != "" && version != "" {
	        print package "-" version ".apk"
	        package = version = ""
	    }
	    END {
	        if (package != "" && version != "")
	            print package "-" version ".apk"
	    }
	' | sort -u >"$expected"
	test -s "$expected"

	while IFS= read -r package; do
		asset=$alpine_release/$prefix$package
		test -s "$asset"
		apk --keys-dir "$(realpath -- "$output/keys")" verify "$asset"
	done <"$expected"

	find "$alpine_release" -maxdepth 1 -type f \
		-name "$prefix*.apk" -print |
	while IFS= read -r asset; do
		package=${asset##*/"$prefix"}
		grep -Fx "$package" "$expected" >/dev/null
	done
done

gzip -cd "$1" >"$work/primary.xml"
if grep -q 'legacy-' "$work/primary.xml"; then
	echo "unsigned legacy RPM found in repository metadata" >&2
	exit 1
fi
rpm_base=https://repo.chapeltech.uk/rpm/el9/x86_64
grep -q "<location xml:base=\"$rpm_base\" href=\"Packages/github/$organization/" \
	"$work/primary.xml"
if grep '<location ' "$work/primary.xml" |
    grep -Fv "xml:base=\"$rpm_base\"" | grep -q .; then
	echo "RPM payload without canonical base URL" >&2
	exit 1
fi
sed -n 's/.*<location .* href="\([^"]*\)".*/\1/p' "$work/primary.xml" |
while IFS= read -r location; do
	case "$location" in
	Packages/github/$organization/*/releases/download/*/*.rpm)
		;;
	*)
		echo "non-canonical RPM payload URL: $location" >&2
		exit 1
		;;
	esac
	case "$location" in
	*/latest/download/*)
		echo "mutable RPM payload URL: $location" >&2
		exit 1
		;;
	esac
	relative=${location#Packages/github/"$organization"/}
	repository=${relative%%/*}
	if ! jq -e --arg repository "$repository" \
	    '.repositories | index($repository) != null' "$manifest" >/dev/null; then
		echo "unconfigured RPM payload repository: $repository" >&2
		exit 1
	fi
done

for repository in $(jq -r '.repositories[]' "$manifest"); do
	grep -q "href=\"Packages/github/$organization/$repository/releases/download/" \
	    "$work/primary.xml"
done

if find "$output" \( -type l -o -type f \( -name '*.apk' -o \
    -name '*.deb' -o -name '*.rpm' \) \) \
	-print -quit | grep -q .; then
	echo "package payload found in static output" >&2
	exit 1
fi

for netlify_file in _redirects wrangler.jsonc .assetsignore; do
	test ! -e "$output/$netlify_file"
done
