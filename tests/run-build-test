#!/bin/sh

set -eu

passphrase=test-passphrase
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
artifacts=$work/artifacts
full_gnupg=$work/full-gnupg
signing_gnupg=$work/signing-gnupg
rpmtop=$work/rpmbuild
rpmdb=$work/rpmdb
tag=v-test

ALPINE_SIGNING_KEY=$(cat /alpine-fixtures/chapeltech-alpine.rsa)
export ALPINE_SIGNING_KEY

mkdir -m 700 "$full_gnupg"
export GNUPGHOME="$full_gnupg"
gpg --batch --pinentry-mode loopback --passphrase "$passphrase" \
	--quick-gen-key 'Repository Test Primary <test@example.invalid>' \
	rsa2048 cert 1d
primary=$(gpg --batch --with-colons --list-secret-keys |
	awk -F: '$1 == "fpr" { print $10; exit }')
gpg --batch --pinentry-mode loopback --passphrase "$passphrase" \
	--quick-add-key "$primary" rsa2048 sign 1d
subkey=$(gpg --batch --with-colons --list-secret-keys "$primary" |
	awk -F: '
        $1 == "ssb" { candidate = 1; next }
        $1 == "fpr" && candidate { print $10; exit }
    ')

ARCHIVE_SIGNING_SUBKEY_FINGERPRINT=$subkey
ARCHIVE_SIGNING_PASSPHRASE=$passphrase
export ARCHIVE_SIGNING_SUBKEY_FINGERPRINT ARCHIVE_SIGNING_PASSPHRASE

if scripts/check-signing-key >/dev/null 2>&1; then
	echo "full primary secret key was not rejected" >&2
	exit 1
fi

mkdir -p "$rpmtop/SPECS"
rpm --define "_dbpath $rpmdb" --initdb
printf '%s' "$passphrase" >"$work/passphrase"
chmod 600 "$work/passphrase"

for repository in $(jq -r '.repositories[]' packages.json); do
	package=$(printf '%s' "$repository" | tr _ -)
	mkdir -p "$artifacts/$repository/$tag"
	for arch in amd64 arm64; do
		root=$work/deb-$package-$arch
		mkdir -p "$root/DEBIAN" "$root/usr/bin"
		cat >"$root/DEBIAN/control" <<EOF
Package: $package
Version: 1.0-1
Architecture: $arch
Maintainer: ChapelTech <repo@chapeltech.uk>
Description: synthetic $repository repository test package
EOF
		printf '#!/bin/sh\nexit 0\n' >"$root/usr/bin/$package"
		chmod 755 "$root/usr/bin/$package"
		deb_name=${package}_1.0-1_${arch}.deb
		dpkg-deb --build --root-owner-group "$root" \
			"$artifacts/$repository/$tag/$deb_name" >/dev/null
		url=https://github.com/chapeltech/$repository/releases/download/$tag/$deb_name
		printf '%s\t%s\t%s\t%s\n' "$repository" "$tag" "$deb_name" "$url" \
			>>"$artifacts/releases.tsv"
	done

	cat >"$rpmtop/SPECS/$package.spec" <<EOF
Name: $package
Version: 1.0
Release: 1%{?dist}
Summary: Synthetic $repository repository test package
License: MIT
BuildArch: x86_64

%description
Synthetic package used only by the package repository integration test.

%install
mkdir -p %{buildroot}/usr/share/$package
touch %{buildroot}/usr/share/$package/repository-test

%files
/usr/share/$package/repository-test
EOF
	rpmbuild --quiet --define "_dbpath $rpmdb" \
		--define "_topdir $rpmtop" --define 'dist .el9' \
		-bb "$rpmtop/SPECS/$package.spec"
	rpm_path=$(find "$rpmtop/RPMS/x86_64" -type f \
		-name "$package-*.rpm" -print -quit)
	unsigned_name=legacy-$(basename -- "$rpm_path")
	cp "$rpm_path" "$artifacts/$repository/$tag/$unsigned_name"
	url=https://github.com/chapeltech/$repository/releases/download/$tag/$unsigned_name
	printf '%s\t%s\t%s\t%s\n' "$repository" "$tag" "$unsigned_name" "$url" \
		>>"$artifacts/releases.tsv"
	rpmsign --addsign \
		--define "_dbpath $rpmdb" \
		--define "_gpg_name $subkey" \
		--define "_gpg_sign_cmd_extra_args --batch --pinentry-mode loopback --passphrase-file $work/passphrase" \
		"$rpm_path"
	rpm_name=$(basename -- "$rpm_path")
	cp "$rpm_path" "$artifacts/$repository/$tag/$rpm_name"
	url=https://github.com/chapeltech/$repository/releases/download/$tag/$rpm_name
	printf '%s\t%s\t%s\t%s\n' "$repository" "$tag" "$rpm_name" "$url" \
			>>"$artifacts/releases.tsv"

	apk_source=$(find /alpine-fixtures -type f \
		-name "$package-1.0-r0.apk" -print -quit)
	test -n "$apk_source"
	for arch in x86_64 aarch64; do
		apk_name=$package-1.0-r0.$arch.apk
		cp "$apk_source" "$artifacts/$repository/$tag/$apk_name"
		url=https://github.com/chapeltech/$repository/releases/download/$tag/$apk_name
		printf '%s\t%s\t%s\t%s\n' "$repository" "$tag" "$apk_name" "$url" \
			>>"$artifacts/releases.tsv"
	done
done

gpg --batch --pinentry-mode loopback --passphrase "$passphrase" \
	--armor --export-secret-subkeys "$subkey!" \
	>"$work/archive-signing-subkey.asc"
mkdir -m 700 "$signing_gnupg"
export GNUPGHOME="$signing_gnupg"
gpg --batch --import "$work/archive-signing-subkey.asc" >/dev/null

scripts/check-signing-key
scripts/build-repositories "$artifacts" public-test
scripts/validate-output public-test
