#!/bin/sh

set -eu

top=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
mkdir -p "$work/bin"

cat >"$work/bin/gh" <<'EOF'
#!/bin/sh
set -eu
test "$1" = api
case "$2" in
repos/chapeltech/*/releases/latest)
	repository=${2#repos/chapeltech/}
	repository=${repository%/releases/latest}
	cat "$MOCK_RELEASE_DIR/$repository.json"
	;;
*)
	echo "unexpected API request: $2" >&2
	exit 1
	;;
esac
EOF

cat >"$work/bin/curl" <<'EOF'
#!/bin/sh
set -eu
output=
url=
while [ "$#" -gt 0 ]; do
	case "$1" in
	--output)
		output=$2
		shift 2
		;;
	--retry)
		shift 2
		;;
	--*)
		shift
		;;
	*)
		url=$1
		shift
		;;
	esac
done
test -n "$output"
test -n "$url"
printf '%s\n' "$url" >>"$MOCK_DOWNLOADS"
printf '%s\n' fixture >"$output"
EOF
chmod 755 "$work/bin/gh" "$work/bin/curl"

release_dir=$work/releases
downloads=$work/downloads
mkdir -p "$release_dir"
export MOCK_RELEASE_DIR="$release_dir" MOCK_DOWNLOADS="$downloads"
PATH=$work/bin:$PATH
export PATH

for repository in $(jq -r '.repositories[]' "$top/packages.json"); do
cat >"$release_dir/$repository.json" <<EOF
{
  "tag_name": "v-test",
  "draft": false,
  "prerelease": false,
  "assets": [
    {
      "name": "${repository}_1.0-1_amd64.deb",
      "browser_download_url": "https://github.com/chapeltech/$repository/releases/download/v-test/${repository}_1.0-1_amd64.deb"
    },
    {
      "name": "${repository}_1.0-1_arm64.deb",
      "browser_download_url": "https://github.com/chapeltech/$repository/releases/download/v-test/${repository}_1.0-1_arm64.deb"
    },
    {
      "name": "${repository}-1.0-1.el9.x86_64.rpm",
      "browser_download_url": "https://github.com/chapeltech/$repository/releases/download/v-test/${repository}-1.0-1.el9.x86_64.rpm"
    },
    {
      "name": "${repository}-1.0-1.el9.src.rpm",
      "browser_download_url": "https://github.com/chapeltech/$repository/releases/download/v-test/${repository}-1.0-1.el9.src.rpm"
    },
    {
      "name": "${repository}-1.0-r0.x86_64.apk",
      "browser_download_url": "https://github.com/chapeltech/$repository/releases/download/v-test/${repository}-1.0-r0.x86_64.apk"
    },
    {
      "name": "${repository}-1.0-r0.aarch64.apk",
      "browser_download_url": "https://github.com/chapeltech/$repository/releases/download/v-test/${repository}-1.0-r0.aarch64.apk"
    }
  ]
}
EOF
done

"$top/scripts/fetch-releases" "$work/artifacts"
repository_count=$(jq '.repositories | length' "$top/packages.json")
test "$(wc -l <"$work/artifacts/releases.tsv")" -eq "$((repository_count * 5))"
test "$(wc -l <"$downloads")" -eq "$((repository_count * 5))"
for repository in $(jq -r '.repositories[]' "$top/packages.json"); do
	test "$(awk -F '\t' -v repository="$repository" \
	    '$1 == repository && $2 == "v-test" { count++ } END { print count + 0 }' \
	    "$work/artifacts/releases.tsv")" -eq 5
done

jq '.prerelease = true' "$release_dir/prefork.json" \
	>"$release_dir/prefork-prerelease.json"
mv "$release_dir/prefork-prerelease.json" "$release_dir/prefork.json"
if "$top/scripts/fetch-releases" "$work/prerelease-artifacts" \
	>"$work/prerelease.stdout" 2>"$work/prerelease.stderr"; then
	echo "prerelease was not rejected" >&2
	exit 1
fi
grep -q 'is not a stable release' "$work/prerelease.stderr"
