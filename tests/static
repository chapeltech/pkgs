#!/bin/sh

set -eu

top=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

find "$top/scripts" "$top/tests" -type f -perm -0100 -print |
while IFS= read -r script; do
	sh -n "$script"
done

if command -v shellcheck >/dev/null 2>&1; then
	shellcheck "$top"/scripts/* "$top"/tests/build-repositories \
		"$top"/tests/fetch-releases "$top"/tests/run-build-test \
		"$top"/tests/static
fi

set -- "$top/.github/workflows/publish.yml" \
	"$top/.github/workflows/release-packages.yml"

if command -v yamllint >/dev/null 2>&1; then
	yamllint -d '{extends: default, rules: {line-length: disable, truthy: disable}}' \
		"$@"
else
	python3 - "$@" <<'PY'
import sys
import yaml

for path in sys.argv[1:]:
    with open(path, encoding="utf-8") as source:
        yaml.load(source, Loader=yaml.BaseLoader)
PY
fi

grep -q '^  workflow_call:$' \
	"$top/.github/workflows/release-packages.yml"
grep -Fq \
	'container: quay.io/rockylinux/rockylinux:9.6@sha256:91bbb8eb52ca462611c1f9ce5c4cede4172a31bfe64f336e82f29648694a3cfe' \
	"$top/.github/workflows/release-packages.yml"
grep -Fq "printf '9.6\\n' >/etc/dnf/vars/releasever" \
	"$top/.github/workflows/release-packages.yml"

jq -e '
    .organization == "chapeltech" and
    .repositories == [
        "prefork",
        "lnetd",
        "knc",
        "kharon",
        "krb5_admin",
        "krb5_keytab"
    ] and
    .alpine_repositories == [
        "prefork",
        "lnetd",
        "knc",
        "kharon",
        "krb5_keytab"
    ]
' "$top/packages.json" >/dev/null

git -C "$top" check-ignore -q artifacts/example
git -C "$top" check-ignore -q alpine-release/example
git -C "$top" check-ignore -q alpine-release-test/example
git -C "$top" check-ignore -q public/example
git -C "$top" check-ignore -q public-test/example

expected=$(mktemp)
trap 'rm -f "$expected"' EXIT HUP INT TERM
cat >"$expected" <<'EOF'
/debian/pool/github/* https://github.com/:splat 302!
/rpm/el9/x86_64/Packages/github/* https://github.com/:splat 302!
/alpine/v3.24/main/aarch64/* https://github.com/chapeltech/pkgs/releases/latest/download/alpine-aarch64-:splat 302!
/alpine/v3.24/main/x86_64/* https://github.com/chapeltech/pkgs/releases/latest/download/alpine-x86_64-:splat 302!
/ https://raw.githubusercontent.com/chapeltech/pkgs/repository/index.html 302!
/* https://raw.githubusercontent.com/chapeltech/pkgs/repository/:splat 302!
EOF
cmp "$expected" "$top/netlify/_redirects"

marker='BEGIN PGP PRIVATE KEY'' BLOCK'
matches=$(find "$top" \
	\( -path "$top/.git" -o -path "$top/artifacts" -o \
	   -path "$top/public" -o -path "$top/public-test" \) -prune -o \
	-type f -exec grep -Il "$marker" {} +) || true
if [ -n "$matches" ]; then
	echo "private key armor found in source tree:" >&2
	printf '%s\n' "$matches" >&2
	exit 1
fi

find "$top" \
	\( -path "$top/.git" -o -path "$top/artifacts" -o \
	   -path "$top/public" -o -path "$top/public-test" \) -prune -o \
	-type f \( -name '*.asc' -o -name '*.gpg' -o -name '*.pgp' \) -print |
while IFS= read -r key_file; do
	if gpg --batch --list-packets "$key_file" 2>/dev/null |
	    grep -Eq '^:secret (key|sub key) packet:'; then
		echo "private key packet found in source tree: $key_file" >&2
		exit 1
	fi
done
